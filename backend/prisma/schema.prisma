generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum InvoiceType {
  STANDARD
  CORRECTIVE
  PROFORMA
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  DIRECT_DEBIT
  OTHER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalEntrySource {
  INVOICE
  PAYMENT
  MANUAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ISSUE
  CANCEL
  PAY
}
enum ClientType {
  COMPANY
  FREELANCER
  INDIVIDUAL
  PUBLIC_ENTITY
  OTHER
}

enum TaxIdType {
  NIF
  CIF
  NIE
  VAT
  PASSPORT
  OTHER
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  nif       String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  clients        Client[]
  products       Product[]
  invoices       Invoice[]
  invoiceSeries  InvoiceSeries[]
  accounts       AccountingAccount[]
  journalEntries JournalEntry[]
  auditLogs      AuditLog[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId    Int?
  company      Company? @relation(fields: [companyId], references: [id])

  auditLogs    AuditLog[]
}

model Client {
  id        Int        @id @default(autoincrement())

  legalName  String   @map("name")
  tradeName  String?
  type       ClientType @default(COMPANY)

  taxId      String?  @map("nif")
  taxIdType  TaxIdType @default(CIF)

  email          String?
  invoicingEmail String?
  phone          String?
  contactName    String?

  address    String?
  city       String?
  province   String?
  postalCode String?
  countryCode String @default("ES")

  paymentTermsDays Int @default(0)
  notes            String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  invoices  Invoice[]

  @@index([companyId])
  @@index([companyId, active])
  @@index([companyId, taxId])
}

model Product {
  id          Int         @id @default(autoincrement())

  code        String?
  name        String
  description String?

  type        ProductType @default(SERVICE)

  unit        String      @default("unit")
  price       Decimal     @db.Decimal(10, 2)
  costPrice   Decimal?    @db.Decimal(10, 2)
  taxRate     Decimal     @default(21) @db.Decimal(5, 2)

  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  companyId   Int
  company     Company @relation(fields: [companyId], references: [id])

  revenueAccountId Int?
  revenueAccount   AccountingAccount? @relation("ProductRevenueAccount", fields: [revenueAccountId], references: [id])

  invoiceLines InvoiceLine[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, active])
  @@index([companyId, type])
}

model InvoiceSeries {
  id            Int      @id @default(autoincrement())
  code          String
  prefix        String
  currentNumber Int      @default(0)
  year          Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  companyId     Int
  company       Company @relation(fields: [companyId], references: [id])

  invoices      Invoice[]

  @@unique([companyId, code])
}

model Invoice {
  id            Int           @id @default(autoincrement())
  type          InvoiceType   @default(STANDARD)
  status        InvoiceStatus @default(DRAFT)

  invoiceNumber String?
  issueDate     DateTime?
  dueDate       DateTime?

  subtotal      Decimal       @default(0) @db.Decimal(10, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @default(0) @db.Decimal(10, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(10, 2)
  amountDue     Decimal       @default(0) @db.Decimal(10, 2)

  notes         String?

  issuerName    String?
  issuerNif     String?
  issuerAddress String?
  issuerEmail   String?
  issuerPhone   String?

  customerName    String?
  customerNif     String?
  customerAddress String?
  customerEmail   String?
  customerPhone   String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  companyId     Int
  company       Company @relation(fields: [companyId], references: [id])

  clientId      Int
  client        Client @relation(fields: [clientId], references: [id])

  invoiceSeriesId Int?
  invoiceSeries   InvoiceSeries? @relation(fields: [invoiceSeriesId], references: [id])

  rectifiesInvoiceId Int?
  rectifiesInvoice   Invoice?  @relation("InvoiceRectification", fields: [rectifiesInvoiceId], references: [id])
  correctiveInvoices Invoice[] @relation("InvoiceRectification")

  lines         InvoiceLine[]
  taxSummaries  InvoiceTaxSummary[]
  payments      Payment[]
  journalEntries JournalEntry[] @relation("InvoiceJournalEntries")

  @@unique([companyId, invoiceNumber])
}

model InvoiceLine {
  id          Int     @id @default(autoincrement())
  lineNumber  Int

  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  taxRate     Decimal @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(10, 2)
  taxAmount   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId   Int?
  product     Product? @relation(fields: [productId], references: [id])

  @@unique([invoiceId, lineNumber])
}

model InvoiceTaxSummary {
  id        Int     @id @default(autoincrement())
  taxRate   Decimal @db.Decimal(5, 2)
  taxBase   Decimal @db.Decimal(10, 2)
  taxAmount Decimal @db.Decimal(10, 2)

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, taxRate])
}

model Payment {
  id          Int           @id @default(autoincrement())
  amount      Decimal       @db.Decimal(10, 2)
  paymentDate DateTime      @default(now())
  method      PaymentMethod
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  journalEntries JournalEntry[] @relation("PaymentJournalEntries")
}

model AccountingAccount {
  id        Int         @id @default(autoincrement())
  code      String
  name      String
  type      AccountType
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  journalLines JournalLine[]
  productRevenueLinks Product[] @relation("ProductRevenueAccount")

  @@unique([companyId, code])
}

model JournalEntry {
  id          Int                @id @default(autoincrement())
  entryNumber String?
  entryDate   DateTime           @default(now())
  description String?
  source      JournalEntrySource @default(MANUAL)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  companyId   Int
  company     Company @relation(fields: [companyId], references: [id])

  invoiceId   Int?
  invoice     Invoice? @relation("InvoiceJournalEntries", fields: [invoiceId], references: [id])

  paymentId   Int?
  payment     Payment? @relation("PaymentJournalEntries", fields: [paymentId], references: [id])

  lines       JournalLine[]
}

model JournalLine {
  id          Int     @id @default(autoincrement())
  description String?
  debit       Decimal @default(0) @db.Decimal(10, 2)
  credit      Decimal @default(0) @db.Decimal(10, 2)

  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId   Int
  account     AccountingAccount @relation(fields: [accountId], references: [id])
}

model AuditLog {
  id         Int         @id @default(autoincrement())
  entityType String
  entityId   Int?
  action     AuditAction
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime    @default(now())

  companyId  Int?
  company    Company? @relation(fields: [companyId], references: [id])

  userId     Int?
  user       User? @relation(fields: [userId], references: [id])
}
